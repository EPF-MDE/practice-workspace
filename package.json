{
  "name": "practice-workspace",
  "private": true,
  "description": "The Practice workspace: one public engine, one instance per course",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "sh scripts/check.sh",
    "format": "biome format --write . && prettier --write \"**/*.md\" && cd backend && uv run --frozen ruff format .",
    "lint:oxlint": "oxlint -c .oxlintrc.json",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": [
      "biome format --no-errors-on-unmatched --files-ignore-unknown=true",
      "node scripts/check-file-tokens.js"
    ],
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint -c .oxlintrc.json --no-error-on-unmatched-pattern",
    "*.md": "prettier --check",
    "*.py": [
      "uv run --project backend --frozen ruff check",
      "uv run --project backend --frozen ruff format --check"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1"
  }
}
