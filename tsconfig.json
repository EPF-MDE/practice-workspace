// The Sandcastle scripts' types, checked by `npm run check`'s repository part.
// .sandcastle/agent-workflows/tsconfig.json extends it. The front end keeps
// its own, in frontend/.
{
  "include": [".sandcastle/**/*.ts"],
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  }
}
