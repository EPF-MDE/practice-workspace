{
  "name": "practice-workspace-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "generate-client": "cd ../backend && PYTHONPATH=. uv run python scripts/openapi.py ../frontend/openapi.json && cd ../frontend && openapi-ts",
    "test": "playwright test",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo",
    "lint:boundaries": "depcruise src --cache node_modules/.cache/dependency-cruiser --cache-strategy content"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-router": "^1.170.46",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tldraw": "^5.6.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.97.3",
    "@playwright/test": "^1.65.1",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "dependency-cruiser": "^18.8.0"
  }
}
